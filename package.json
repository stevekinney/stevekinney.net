{
  "name": "stevekinney.net-monorepo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x",
    "bun": "1.3.2"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@stevekinney/website",
    "build": "turbo run build --filter=@stevekinney/website && if [ -n \"$VERCEL\" ] && [ -d applications/website/.vercel/output ]; then mkdir -p .vercel/output && cp -R applications/website/.vercel/output/. .vercel/output/; fi",
    "build:report": "bunx build-report",
    "check-build-budget": "bun packages/scripts/build-report/check-build-budget.ts",
    "continuous-integration:build": "turbo run build --filter=@stevekinney/website --summarize && bun run build:report",
    "continuous-integration:validate": "(bun run content:validate & bun run content:images:check & wait) && bun run images:check && bun run lint && bun run check && bun run test:unit",
    "build:stats": "turbo run build:stats --filter=@stevekinney/website",
    "preview": "turbo run preview --filter=@stevekinney/website",
    "test": "turbo run test --filter=@stevekinney/website && bun run test:og-metadata",
    "test:og-metadata": "bunx vitest run tests/og-metadata.test.ts",
    "sync": "turbo run sync --filter=@stevekinney/website",
    "check": "turbo run check --filter=@stevekinney/website",
    "check:watch": "turbo run check:watch --filter=@stevekinney/website",
    "lint": "prettier --cache --check . && eslint --cache .",
    "format": "prettier --write .",
    "clean": "turbo run clean --filter=@stevekinney/website && rm -rf node_modules",
    "content:build": "turbo run content:build --filter=@stevekinney/scripts",
    "content:validate": "turbo run content:validate --filter=@stevekinney/scripts",
    "content:images:check": "turbo run content:images:check --filter=@stevekinney/scripts",
    "images:sync": "turbo run images:sync --filter=@stevekinney/scripts",
    "images:check": "turbo run images:check --filter=@stevekinney/scripts",
    "test:integration": "turbo run test:integration --filter=@stevekinney/website",
    "test:integration:dev": "turbo run test:integration:dev --filter=@stevekinney/website",
    "test:unit": "turbo run test:unit --filter=@stevekinney/website --filter=@stevekinney/scripts",
    "test:storybook": "turbo run test:storybook --filter=@stevekinney/website",
    "storybook": "turbo run storybook --filter=@stevekinney/website",
    "build-storybook": "turbo run build-storybook --filter=@stevekinney/website",
    "prepare": "bun .lefthook/install.ts"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@shikijs/transformers": "^4.4.3",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/svelte": "^10.6.0",
    "@storybook/sveltekit": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.0",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vercel/blob": "^2.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.5.5",
    "axe-playwright": "^2.2.2",
    "caniuse-lite": "^1.0.30001810",
    "change-case": "^5.4.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "html-entities": "^2.6.0",
    "isomorphic-dompurify": "^2.36.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^27.4.0",
    "lefthook": "^2.1.12",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "mdsvex": "^0.12.8",
    "postcss": "^8.5.28",
    "postcss-nesting": "^14.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rehype-slug": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "satori": "^0.18.4",
    "shiki": "^4.4.3",
    "storybook": "^10.6.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-toml": "^0.9.0",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "dependencies": {
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@lucide/svelte": "^1.43.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "class-variance-authority": "^0.7.1",
    "hast-util-to-html": "^9.0.5",
    "hastscript": "^9.0.1",
    "mermaid": "^11.17.2",
    "modern-screenshot": "^4.7.0",
    "prose-writer": "^0.2.3",
    "sharp": "0.35.4",
    "simple-git": "^3.36.0",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.3",
    "@img/sharp-linux-x64": "0.35.4",
    "@img/sharp-libvips-darwin-arm64": "1.3.3",
    "@img/sharp-darwin-arm64": "0.35.4"
  },
  "packageManager": "bun@1.3.2",
  "overrides": {
    "sharp": "0.35.4",
    "@img/sharp-darwin-arm64": "0.35.4",
    "@img/sharp-libvips-darwin-arm64": "1.3.3",
    "@img/sharp-linux-x64": "0.35.4",
    "@img/sharp-libvips-linux-x64": "1.3.3"
  },
  "workspaces": [
    "applications/*",
    "packages/*"
  ]
}
