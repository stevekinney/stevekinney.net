{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@stevekinney/scripts#content:build": {
      "inputs": [
        "../../bun.lock",
        "../../package.json",
        "../../applications/website/package.json",
        "content-build.ts",
        "content-paths.ts",
        "content-repository.ts",
        "content-repository/**/*.ts",
        "../utilities/package.json",
        "../utilities/content-types.ts",
        "../utilities/frontmatter.ts",
        "../utilities/write-formatted-json.ts",
        "../utilities/tailwind-playground.ts",
        "../../applications/website/static/**",
        "../../writing/**",
        "../../courses/**",
        "../../projects/**",
        "build-artifacts.ts",
        "../utilities/tailwind-playground-types.ts",
        "../utilities/tailwind-playground-metadata.ts",
        "content-metadata.ts",
        "check-content-metadata.ts",
        "run-with-content-history.ts"
      ],
      "outputs": [
        "../../applications/website/.generated/content-data.json",
        "../../applications/website/.generated/playground-inputs.json",
        "../../applications/website/.generated/site-tailwind-candidates.txt"
      ]
    },
    "@stevekinney/scripts#content:validate": {
      "inputs": [
        "../../bun.lock",
        "../../package.json",
        "../../applications/website/package.json",
        "validate-content.ts",
        "content-build.ts",
        "content-paths.ts",
        "content-repository.ts",
        "content-repository/**/*.ts",
        "../utilities/package.json",
        "../utilities/content-types.ts",
        "../utilities/frontmatter.ts",
        "../utilities/tailwind-playground-metadata.ts",
        "../utilities/tailwind-playground-types.ts",
        "../utilities/write-formatted-json.ts",
        "build-artifacts.ts",
        "../utilities/tailwind-playground.ts",
        "../../applications/website/static/**",
        "../../writing/**",
        "../../courses/**",
        "../../projects/**",
        "content-metadata.ts",
        "check-content-metadata.ts",
        "run-with-content-history.ts"
      ],
      "cache": false
    },
    "@stevekinney/scripts#content:images:check": {
      "inputs": [
        "run-with-sharp-runtime.ts",
        "validate-image-compatibility.ts",
        "../../image-manifest.json",
        "../../writing/**/*.{png,jpg,jpeg,svg,gif,avif,webp,mp4}",
        "../../courses/**/*.{png,jpg,jpeg,svg,gif,avif,webp,mp4}",
        "../../projects/**/*.{png,jpg,jpeg,svg,gif,avif,webp,mp4}"
      ]
    },
    "@stevekinney/scripts#images:check": {
      "inputs": [
        "check-image-manifest.ts",
        "../../image-manifest.json",
        "../../writing/**/*.{png,jpg,jpeg,svg,gif,avif,webp,mp4}",
        "../../courses/**/*.{png,jpg,jpeg,svg,gif,avif,webp,mp4}",
        "../../projects/**/*.{png,jpg,jpeg,svg,gif,avif,webp,mp4}"
      ]
    },
    "@stevekinney/scripts#images:sync": {
      "cache": false,
      "env": ["BLOB_READ_WRITE_TOKEN"]
    },
    "@stevekinney/scripts#test:unit": {
      "dependsOn": ["@stevekinney/scripts#content:build"],
      "inputs": [
        "build-report/**/*.ts",
        "../../turbo.json",
        "content-repository.test.ts",
        "content-build.ts",
        "content-paths.ts",
        "content-repository.ts",
        "content-repository/**/*.ts",
        "../utilities/content-types.ts",
        "../utilities/frontmatter.ts",
        "../utilities/write-formatted-json.ts",
        "../utilities/tailwind-playground.ts",
        "../../writing/**/*.md",
        "../../courses/**/*.md",
        "../../projects/**/*.md",
        "../../courses/*/index.toml",
        "*.test.ts",
        "playgrounds-build.ts",
        "playground-document.ts",
        "build-artifacts.ts",
        "build-dependencies.ts",
        "tailwind-playground.css",
        "content-enhancements-build.ts",
        "content-enhancement-build-hash.ts",
        "sync-generated-browser-assets.ts",
        "../utilities/**/*.ts",
        "content-metadata.ts",
        "check-content-metadata.ts",
        "run-with-content-history.ts",
        "../../templates/**",
        "../../.obsidian/{core-plugins,templates,types}.json",
        "../../lefthook.yml"
      ]
    },
    "@stevekinney/website#build": {
      "dependsOn": [
        "@stevekinney/website#sync",
        "@stevekinney/scripts#content:build",
        "@stevekinney/scripts#content:images:check",
        "@stevekinney/scripts#playgrounds:build",
        "@stevekinney/scripts#content-enhancements:build"
      ],
      "inputs": [
        "package.json",
        "plugins/**/*.ts",
        "src/**",
        "static/**",
        "svelte.config.ts",
        "vite.config.ts",
        "tsconfig.json",
        "../../packages/components/**/*.{svelte,ts,js}",
        "../../packages/markdown/src/**/*.ts",
        "../../packages/utilities/**/*.ts",
        "../../packages/scripts/*.ts",
        "../../image-manifest.json",
        "!build/**",
        "!.svelte-kit/**",
        "!test-results/**",
        "!playwright-report/**",
        "!.vercel/**",
        "../../vercel.json"
      ],
      "env": ["VERCEL", "VERCEL_ENV"],
      "outputs": ["build/**", ".svelte-kit/output/**", ".vercel/output/**"]
    },
    "@stevekinney/website#build:stats": {
      "dependsOn": ["@stevekinney/website#build"],
      "env": ["BUNDLE_STATS"]
    },
    "@stevekinney/website#preview": {
      "dependsOn": ["@stevekinney/website#build"],
      "cache": false
    },
    "@stevekinney/website#dev": {
      "dependsOn": [
        "@stevekinney/scripts#content:build",
        "@stevekinney/scripts#playgrounds:build",
        "@stevekinney/scripts#content-enhancements:build"
      ],
      "cache": false,
      "persistent": true
    },
    "@stevekinney/website#sync": {
      "cache": false
    },
    "@stevekinney/website#lint": {},
    "@stevekinney/website#check": {
      "dependsOn": [
        "@stevekinney/website#sync",
        "@stevekinney/scripts#content:build",
        "@stevekinney/scripts#playgrounds:build",
        "@stevekinney/scripts#content-enhancements:build"
      ]
    },
    "@stevekinney/website#check:watch": {
      "dependsOn": [
        "@stevekinney/website#sync",
        "@stevekinney/scripts#content:build",
        "@stevekinney/scripts#playgrounds:build",
        "@stevekinney/scripts#content-enhancements:build"
      ],
      "cache": false,
      "persistent": true
    },
    "@stevekinney/website#test": {
      "dependsOn": ["@stevekinney/website#test:integration", "@stevekinney/website#test:unit"]
    },
    "@stevekinney/website#test:integration": {
      "dependsOn": ["@stevekinney/website#build"],
      "env": [
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_BROWSER_CHANNEL",
        "PLAYWRIGHT_PORT",
        "PLAYWRIGHT_WEB_SERVER"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "@stevekinney/website#test:integration:dev": {
      "cache": false,
      "env": [
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_BROWSER_CHANNEL",
        "PLAYWRIGHT_PORT",
        "PLAYWRIGHT_WEB_SERVER"
      ]
    },
    "@stevekinney/website#test:unit": {
      "dependsOn": [
        "@stevekinney/website#sync",
        "@stevekinney/scripts#content:build",
        "@stevekinney/scripts#playgrounds:build",
        "@stevekinney/scripts#content-enhancements:build"
      ],
      "inputs": [
        "src/**",
        "../../vercel.json",
        "svelte.config.ts",
        "tests/**/*.ts",
        "plugins/**/*.ts",
        "vitest.config.*",
        "vite.config.*",
        "tsconfig.json",
        "../../packages/utilities/**/*.ts",
        "../../packages/markdown/src/**/*.ts"
      ]
    },
    "@stevekinney/website#test:storybook": {
      "dependsOn": ["@stevekinney/website#build-storybook"]
    },
    "@stevekinney/website#storybook": {
      "cache": false,
      "persistent": true
    },
    "@stevekinney/website#build-storybook": {},
    "@stevekinney/website#clean": {
      "cache": false
    },
    "@stevekinney/scripts#playgrounds:build": {
      "dependsOn": ["@stevekinney/scripts#content:build"],
      "inputs": [
        "package.json",
        "../../bun.lock",
        "../../.node-version",
        "playgrounds-build.ts",
        "playground-document.ts",
        "build-artifacts.ts",
        "build-dependencies.ts",
        "content-paths.ts",
        "tailwind-playground.css",
        "../utilities/tailwind-playground-types.ts",
        "../utilities/tailwind-playground-policy.ts"
      ],
      "outputs": [
        "../../applications/website/.generated/playgrounds/**",
        "../../applications/website/.generated/playground-cache/**"
      ]
    },
    "@stevekinney/scripts#content-enhancements:build": {
      "inputs": [
        "../../package.json",
        "../../bun.lock",
        "../../.node-version",
        "content-enhancements-build.ts",
        "content-enhancement-build-hash.ts",
        "build-artifacts.ts",
        "content-paths.ts",
        "../content-enhancements/package.json",
        "../content-enhancements/tsconfig.json",
        "../content-enhancements/src/**",
        "../utilities/**/*.ts",
        "!../utilities/**/*.test.ts",
        "../utilities/package.json"
      ],
      "outputs": ["../../applications/website/.generated/content-enhancements/**"]
    },
    "@stevekinney/scripts#content:check": {
      "cache": false
    },
    "@stevekinney/scripts#content:fix": {
      "cache": false
    }
  },
  "globalEnv": ["CONTENT_GIT_REVISION"]
}
